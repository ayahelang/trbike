{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "drivers": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "rides": {
      ".read": "auth != null",
      "$rideId": {
        ".write": "auth != null"
      }
    },
    "fareRules": {
      ".read": true,
      ".write": false
    },
    "system": {
      ".read": true,
      ".write": false
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}